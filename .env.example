# Copy this file to .env and fill in the values. Keep .env private.

# LLM (OpenRouter) - REQUIRED. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, default is openai/gpt-4o-mini (ChatGPT through OpenRouter)
MODEL=

# Web Search MCP - OPTIONAL (leave empty to skip web search)
WEB_SEARCH_MCP_URL=
TAVILY_API_KEY=

# MCP Aggregator
AGGREGATOR_HOST=
AGGREGATOR_PORT=

# Flask
FLASK_HOST=
FLASK_PORT=
FLASK_DEBUG=
SECRET_KEY=

# RAG
EMBEDDING_MODEL=
